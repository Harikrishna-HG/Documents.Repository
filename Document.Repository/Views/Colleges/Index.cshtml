@{
    Layout = "_UserLayout";
}
@model IEnumerable<Document.Repository.Models.Entities.College>

@{
    ViewData["Title"] = "Index";
}

<div class="d-flex justify-content-between align-items-center pt-4">
    <h3 class="mb-0">
        List of Colleges
    </h3>
    <a asp-action="Create" class="btn btn-primary">Add New</a>
</div>

<hr />

<div class="d-flex justify-content-center mx-1 mx-md-2">
    <div class="table-responsive">
        <table class="table table-bordered table-striped">
            <thead class="text-center">
                <tr>
                    <th>
                        @Html.DisplayNameFor(model => model.Name)
                    </th>
                    <th>
                        @Html.DisplayNameFor(model => model.Contact)
                    </th>
                    <th>
                        @Html.DisplayNameFor(model => model.CampusChief)
                    </th>
                    <th>
                        @Html.DisplayNameFor(model => model.Address)
                    </th>
                    <th>
                        @Html.DisplayNameFor(model => model.Details)
                    </th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td>
                            @Html.DisplayFor(modelItem => item.Name)
                        </td>
                        <td>
                            @Html.DisplayFor(modelItem => item.Contact)
                        </td>
                        <td>
                            @Html.DisplayFor(modelItem => item.CampusChief)
                        </td>
                        <td>
                            @Html.DisplayFor(modelItem => item.Address)
                        </td>
                        <td>
                            @Html.DisplayFor(modelItem => item.Details)
                        </td>
                        <td>
                            <!-- Desktop View: Buttons -->
                            <div class="d-flex justify-content-evenly">
                                <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-primary me-2">
                                    <i class="bi bi-pencil"></i>
                                </a>
                                <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-warning me-2">
                                    <i class="bi bi-info-circle"></i>
                                </a>
                                <form asp-action="Delete" method="post" class="d-inline">
                                    <input type="hidden" name="id" value="@item.Id" />
                                    <button type="button"
                                            class="btn btn-sm btn-danger me-2"
                                            onclick="if(confirm('Are you sure you want to delete this college ?')) this.closest('form').submit();">
                                        <i class="bi bi-trash3"></i>
                                    </button>
                                </form>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

