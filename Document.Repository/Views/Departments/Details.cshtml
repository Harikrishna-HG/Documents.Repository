@{
    Layout = "_UserLayout";
}
@model Document.Repository.Models.Entities.Department

@{
    ViewData["Title"] = "Details";
}

<h1 class="text-center pt-4">Details</h1>

<div class="mx-auto p-4 shadow" style="max-width: 700px; background-color: #f8f9fa; border-radius: 10px;">
    <h4 class="text-center">Department</h4>
    <hr />
    <dl class="row">
        <dt class = "col-sm-2">@Html.DisplayNameFor(model => model.Name)</dt>
        <dd class = "col-sm-10">@Html.DisplayFor(model => model.Name)</dd>
        <dt class = "col-sm-2">@Html.DisplayNameFor(model => model.Details)</dt>
        <dd class = "col-sm-10">@Html.DisplayFor(model => model.Details)</dd>
        <dt class = "col-sm-2"> @Html.DisplayNameFor(model => model.Head)</dt>
        <dd class = "col-sm-10">@Html.DisplayFor(model => model.Head)</dd>
        <dt class = "col-sm-2">@Html.DisplayNameFor(model => model.Extension)</dt>
        <dd class = "col-sm-10">@Html.DisplayFor(model => model.Extension)</dd>
        <dt class = "col-sm-2">@Html.DisplayNameFor(model => model.College)</dt>
        <dd class = "col-sm-10">@Html.DisplayFor(model => model.College.Name)</dd>
    </dl>

    <div class="d-flex mt-4">
        <a asp-action="Edit" asp-route-id="@Model?.Id" class="btn btn-warning flex-fill me-2" style="width: 50%;">Edit</a>
        <a asp-action="Index" class="btn btn-primary flex-fill ms-2" style="width: 50%;">Back to List</a>
    </div>
</div>

