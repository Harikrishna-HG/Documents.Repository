@{
    Layout = "_UserLayout";
}
@model Document.Repository.Models.Entities.Department

@{
    ViewData["Title"] = "Edit";
}

<h3 class="text-center">Edit The Department Detail</h3>
<hr />
<div class="container mt-4 mb-4">
    <div class="row justify-content-center">
        <div class="col-md-10 col-lg-12">
            <div class="p-4 rounded" style="background-color: #f8f9fa;">
                <form asp-action="Edit">
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
                    <input type="hidden" asp-for="Id" />

                    <div class="row g-3">
                        <!-- Department Name -->
                        <div class="col-md-6">
                            <div class="mb-3">
                                <label asp-for="Name" class="form-label fw-bolder">Department Name <span style="color: red">*</span></label>
                                <input asp-for="Name" class="form-control" />
                                <span asp-validation-for="Name" class="text-danger"></span>
                            </div>
                        </div>

                        <!-- College Selection -->
                        <div class="col-md-6">
                            <div class="mb-3">
                                <label asp-for="CollegeId" class="form-label fw-bolder">College <span style="color: red">*</span></label>
                                <select asp-for="CollegeId" class="form-control" asp-items="ViewBag.CollegeId"></select>
                            </div>
                        </div>

                        <!-- Department Head -->
                        <div class="col-md-6">
                            <div class="mb-3">
                                <label asp-for="Head" class="form-label fw-bolder">Head of Department <span style="color: red">*</span></label>
                                <input asp-for="Head" class="form-control" />
                                <span asp-validation-for="Head" class="text-danger"></span>
                            </div>
                        </div>

                        <!-- Extension -->
                        <div class="col-md-6">
                            <div class="mb-3">
                                <label asp-for="Extension" class="form-label fw-bolder">Extension</label>
                                <input asp-for="Extension" class="form-control" />
                                <span asp-validation-for="Extension" class="text-danger"></span>
                            </div>
                        </div>

                       


                        <!-- Department Details -->
                        <div class="col-12">
                            <div class="mb-3">
                                <label for="details" class="form-label fw-bolder">Details</label>
                                <textarea asp-for="Details" class="form-control" rows="4" placeholder="Enter College Details..."></textarea>
                                <span asp-validation-for="Details" class="text-danger"></span>
                            </div>
                        </div>
                    </div>

                    <!-- Submit Button & Back to List Button -->
                    <div class="d-flex justify-content-between mt-4">
                        <button type="submit" class="btn btn-primary " asp-action="Index">Cancel</button>
                        <button type="submit" class="btn btn-primary">Save</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
