@model Document.Repository.Controllers.HomeViewModel
@{
    ViewData["Title"] = "Home - FWU Central E-Library";
    ViewData["Description"] = "Explore the FWU Central E-Library for academic projects, resources, and more.";
    ViewData["Keywords"] = "FWU, E-Library, Projects, Academic Resources";
    ViewData["Author"] = "Farwestern University";
}
<!-- Carousel  -->
@if (Model.SliderImages != null && Model.SliderImages.Any())
{
    <div id="carouselExampleCaptions" class="carousel slide" data-bs-ride="carousel">
        <div class="carousel-inner">
            @for (int i = 0; i < Model.SliderImages.Count(); i++)
            {
                var image = Model.SliderImages.ElementAt(i);
                <div class="carousel-item @(i == 0 ? "active" : "")">
                    <img src="@Url.Content("~/" + image.ImageUpload)" class="d-block w-100" alt="@image.Title">
                    <div class="carousel-caption d-none d-md-block">
                        <h2>@image.Title</h2>
                        <p>@image.Description</p>
                    </div>
                </div>
            }
        </div>
        <button class="carousel-control-prev" type="button" data-bs-target="#carouselExampleCaptions" data-bs-slide="prev">
            <span class="carousel-control-prev-icon" aria-hidden="true"></span>
            <span class="visually-hidden">Previous</span>
        </button>
        <button class="carousel-control-next" type="button" data-bs-target="#carouselExampleCaptions" data-bs-slide="next">
            <span class="carousel-control-next-icon" aria-hidden="true"></span>
            <span class="visually-hidden">Next</span>
        </button>
    </div>
}

<div id="tableProjectsSection">
    @await Html.PartialAsync("_TableProjectsPartial", Model)
</div>

<div id="projectsSection">
    @await Html.PartialAsync("_ProjectsPartial", Model.Projects)
</div>

<!-- Single Modal (Outside Loop) -->
<div class="modal fade" id="pdfModal" tabindex="-1" aria-labelledby="pdfModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-xl">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="pdfModalLabel">PDF Viewer</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <iframe id="modalPdfViewer"
                        title="PDF Viewer"
                        style="border: none; width: 100%; height: 80vh;">
                </iframe>
            </div>
        </div>
    </div>
</div>

<script>
    // JavaScript to Handle PDF Loading
    document.addEventListener('DOMContentLoaded', function() {
        var pdfModal = document.getElementById('pdfModal');

        pdfModal.addEventListener('show.bs.modal', function (event) {
            var button = event.relatedTarget;
            var pdfPath = button.getAttribute('data-pdfpath');
            var pdfIframe = document.getElementById('modalPdfViewer');
            pdfIframe.src = pdfPath;
        });

        // Reset PDF source when modal closes
        pdfModal.addEventListener('hidden.bs.modal', function () {
            var pdfIframe = document.getElementById('modalPdfViewer');
            pdfIframe.src = '';
        });
    });
</script>
<script>
   document.addEventListener('DOMContentLoaded', function () {
    const projectsSection = document.getElementById('projectsSection');

    projectsSection.addEventListener('click', function (event) {
        if (event.target.classList.contains('project-pagination')) {
            event.preventDefault();

            const page = event.target.getAttribute('data-page');
            if (!page || page < 1) return;

            fetch(`/Home/Index?projectsPageIndex=${page}&isAjaxRequest=true&section=projects`, {
                headers: { 'X-Requested-With': 'XMLHttpRequest' }
            })
            .then(response => response.text())
            .then(html => {
                projectsSection.innerHTML = html;
            })
            .catch(error => console.error('Error loading projects:', error));
        }
    });
});

</script>
<script>
document.addEventListener('DOMContentLoaded', function () {
    const tableProjectsSection = document.getElementById('tableProjectsSection');

    tableProjectsSection.addEventListener('click', function (event) {
        if (event.target.classList.contains('table-pagination')) {
            event.preventDefault();

            const page = event.target.getAttribute('data-page');
            if (!page || page < 1) return;

            fetch(`/Home/Index?tablePageIndex=${page}&isAjaxRequest=true&section=tableProjects`, {
                headers: { 'X-Requested-With': 'XMLHttpRequest' }
            })
            .then(response => response.text())
            .then(html => {
                tableProjectsSection.innerHTML = html;
            })
            .catch(error => console.error('Error loading table projects:', error));
        }
    });
});

</script>
