@{
    Layout = "_UserLayout";
}
@model Document.Repository.Models.Entities.Programme

@{
    ViewData["Title"] = "Edit";
}

<h3 class="text-center">Edit The Programme Detail</h3>
<hr />

<div class="container mt-4 mb-4">
    <div class="row justify-content-center">
        <div class="col-md-10 col-lg-12">
            <div class="p-4 rounded" >
                <form asp-action="Edit">
                    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                    <input type="hidden" asp-for="Id" />
                    <div class="row g-3">

                        <!-- Programme Name -->
                        <div class="col-md-6">
                            <div class="mb-3">
                                <label for="Name" class="form-label fw-bolder">Programme Name <span style="color: red">*</span></label>
                                <input asp-for="Name" class="form-control" placeholder="Enter Programme Name" />
                                <span asp-validation-for="Name" class="text-danger"></span>
                            </div>
                        </div>

                        <!-- College -->
                        <div class="col-md-6">
                            <div class="mb-3">
                                <label for="CollegeId" class="form-label fw-bolder">College <span style="color: red">*</span></label>
                                <select id="CollegeId" name="CollegeId" class="form-control">
                                    <option disabled>-- Select College --</option>
                                    @foreach (var college in ViewBag.CollegeId as SelectList)
                                    {
                                        if (Model?.Department?.CollegeId != null && college.Value == (Model.Department.CollegeId.ToString()))
                                        {
                                            <option value="@college.Value" selected>@college.Text</option>
                                        }
                                        else
                                        {
                                            <option value="@college.Value">@college.Text</option>
                                        }
                                    }
                                </select>
                            </div>
                        </div>

                        <!-- Department -->
                        <div class="col-md-12">
                            <div class="mb-3">
                                <label for="DepartmentId" class="form-label fw-bolder">Department <span style="color: red">*</span></label>
                                <select asp-for="DepartmentId" id="DepartmentId" class="form-control" asp-items="ViewBag.SiblingDepartments">
                                    <option disabled>-- Select Department --</option>
                                </select>
                                <span asp-validation-for="DepartmentId" class="text-danger"></span>
                            </div>
                        </div>

                        <!-- Program Details -->
                        <div class="col-12">
                            <div class="mb-3">
                                <label for="details" class="form-label fw-bolder">Details</label>
                                <textarea asp-for="Details" class="form-control" rows="4" placeholder="Enter Program Details..."></textarea>
                                <span asp-validation-for="Details" class="text-danger"></span>
                            </div>
                        </div>

                    </div>

                    <!-- Submit Button & Back to List Button -->
                    <div class="d-flex justify-content-between mt-4">
                        <a asp-action="Index" class="btn btn-primary">Cancel</a>
                        <button type="submit" class="btn btn-primary">Save</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery/3.6.0/jquery.min.js"></script>
    <script>
        $(document).ready(function () {
            $('#CollegeId').change(function () {
                var collegeId = $(this).val();
                var departmentDropdown = $('#DepartmentId');
                departmentDropdown.empty();
                departmentDropdown.append('<option disabled selected>-- Select Department --</option>');

                if (collegeId) {
                    $.ajax({
                        url: '@Url.Action("GetDepartmentsByCollege", "Programmes")',
                        type: 'GET',
                        data: { collegeId: collegeId },
                        success: function (data) {
                            $.each(data, function (index, department) {
                                departmentDropdown.append(
                                    $('<option></option>').val(department.id).html(department.name)
                                );
                            });
                        },
                        error: function () {
                            alert('Error loading departments');
                        }
                    });
                }
            });
        });
    </script>
}

