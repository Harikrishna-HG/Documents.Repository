@{
    Layout = "_UserLayout";
}
@model IEnumerable<Document.Repository.Models.Entities.Project>

@{
    ViewData["Title"] = "Index";
    var currentSearch = Context.Request.Query["searchString"];
}

<div class="d-flex flex-column flex-md-row justify-content-between align-items-center pt-4 pb-2 gap-2">
    <h3 class="mb-0">List of Projects</h3>

    <div class="d-flex flex-wrap gap-2">
        <form class="d-flex" asp-action="Index" asp-controller="Projects" method="get">
            <input type="search" name="searchString" class="form-control me-2 w-auto" placeholder="Search by Title or Abstract" value="@currentSearch" />
            <button type="submit" class="btn btn-outline-primary">Search</button>
        </form>

        @if (!string.IsNullOrEmpty(currentSearch))
        {
            <a asp-action="Index" class="btn btn-outline-secondary">Back to full list</a>
        }

        <a asp-action="Create" class="btn btn-primary">Add New</a>
    </div>
</div>
<hr />

<div class="table-responsive mx-1 mx-md-2">
    <table class="table table-bordered table-striped align-middle">
        <thead class="text-center">
            <tr>
                <th>
                    <a asp-action="Index"
                       asp-route-sortOrder="@ViewData["TitleSortParam"]"
                       asp-route-searchString="@currentSearch"
                       class="text-decoration-none text-dark">
                        @Html.DisplayNameFor(model => model.Title)
                        @if (ViewData["CurrentSort"]?.ToString() == "")
                        {
                            <i class="bi bi-arrow-down"></i> <!-- Ascending -->
                        }
                        else if (ViewData["CurrentSort"]?.ToString() == "title_desc")
                        {
                            <i class="bi bi-arrow-up"></i> <!-- Descending -->
                        }
                        else
                        {
                            <i class="bi bi-arrow-down-up"></i> <!-- Default/neutral -->
                        }
                    </a>
                </th>

                <th>
                    <a asp-action="Index"
                       asp-route-sortOrder="@ViewData["DateSortParam"]"
                       asp-route-searchString="@currentSearch"
                       class="text-decoration-none text-dark">
                        @Html.DisplayNameFor(model => model.CreatedDate)
                        @if (ViewData["CurrentSort"]?.ToString() == "Date")
                        {
                            <i class="bi bi-arrow-down"></i>
                        }
                        else if (ViewData["CurrentSort"]?.ToString() == "date_desc")
                        {
                            <i class="bi bi-arrow-up"></i>
                        }
                        else
                        {
                            <i class="bi bi-arrow-down-up"></i>
                        }
                    </a>
                </th>
                <th>
                    @Html.DisplayNameFor(model => model.Status)
                </th>
                <th>
                    Approval
                </th>
                <th>
                    @Html.DisplayNameFor(model => model.Abstract)
                </th>
                <th>
                    @Html.DisplayNameFor(model => model.Tags)
                </th>
                <th>
                    @Html.DisplayNameFor(model => model.Student)
                </th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@Html.DisplayFor(modelItem => item.Title)</td>
                    <td>@Html.DisplayFor(modelItem => item.CreatedDate)</td>

                    <td class="text-center align-middle">
                        <span class="badge
                            @(item.Status == Document.Repository.Models.Entities.ProjectStatus.Approved ? "bg-success" :
                              item.Status == Document.Repository.Models.Entities.ProjectStatus.Rejected ? "bg-danger" : "bg-secondary")">
                            @item.Status
                        </span>
                    </td>

                    <td class="text-center align-middle">
                        @if (User.IsInRole("Admin") || User.IsInRole("CollegeAdmin") || User.IsInRole("SuperAdmin"))
                        {
                            <div class="d-flex flex-wrap justify-content-center gap-1">
                                <form asp-action="ChangeStatus" method="post">
                                    <input type="hidden" name="id" value="@item.Id" />
                                    <input type="hidden" name="status" value="Approved" />
                                    <button type="submit" class="btn btn-sm btn-outline-success"
                                    @(item.Status == Document.Repository.Models.Entities.ProjectStatus.Approved ? "disabled" : "")>
                                        <i class="bi bi-check-circle"></i> Approve
                                    </button>
                                </form>

                                <form asp-action="ChangeStatus" method="post">
                                    <input type="hidden" name="id" value="@item.Id" />
                                    <input type="hidden" name="status" value="Rejected" />
                                    <button type="submit" class="btn btn-sm btn-outline-danger"
                                    @(item.Status == Document.Repository.Models.Entities.ProjectStatus.Rejected ? "disabled" : "")>
                                        <i class="bi bi-x-circle"></i> Reject
                                    </button>
                                </form>
                            </div>
                        }
                        else
                        {
                            <span class="text-muted small fst-italic">No Access</span>
                        }
                    </td>

                    <td>
                        @(string.IsNullOrEmpty(item.Abstract)
                            ? "No Abstract"
                            : (item.Abstract.Length > 180
                            ? item.Abstract.Substring(0, 80) + "..."
                            : item.Abstract))
                    </td>
                    <td>
                        @if (item.Tags != null && item.Tags.Count > 0)
                        {
                            <ul class="mb-0 ps-3">
                                @foreach (var tag in item.Tags)
                                {
                                    <li>@tag.Name</li>
                                }
                            </ul>
                        }
                        else
                        {
                            <span>No Tags</span>
                        }
                    </td>

                    <td>@Html.DisplayFor(modelItem => item.Student.Name)</td>

                    <td>
                        <div class="d-flex justify-content-evenly flex-wrap gap-1">
                            <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-primary">
                                <i class="bi bi-pencil"></i>
                            </a>
                            <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-warning">
                                <i class="bi bi-info-circle"></i>
                            </a>
                            <form asp-action="Delete" method="post" class="d-inline">
                                <input type="hidden" name="id" value="@item.Id" />
                                <button type="button"
                                        class="btn btn-sm btn-danger"
                                        onclick="if(confirm('Are you sure you want to delete this project?')) this.closest('form').submit();">
                                    <i class="bi bi-trash3"></i>
                                </button>
                            </form>
                        </div>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
