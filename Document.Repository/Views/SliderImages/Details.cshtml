@model Document.Repository.Models.Entities.SliderImage

@{
    ViewData["Title"] = "Details";
    Layout = "_UserLayout"; // Matching your college form layout
}

<h1 class="text-center">Details</h1>
<hr />
<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <table class="table table-bordered table-responsive">
                <tbody>
                    <tr>
                        <th class="col-sm-3">@Html.DisplayNameFor(model => model.Title)</th>
                        <td class="col-sm-9">@Html.DisplayFor(model => model.Title)</td>
                    </tr>
                    <tr>
                        <th class="col-sm-3">@Html.DisplayNameFor(model => model.Description)</th>
                        <td class="col-sm-9">@Html.DisplayFor(model => model.Description)</td>
                    </tr>
                    <tr>
                        <th class="col-sm-3">@Html.DisplayNameFor(model => model.ImageUpload)</th>
                        <td class="col-sm-9">
                            <a href="@Url.Content("~/SliderImages/" + System.IO.Path.GetFileName(Model.ImageUpload))" target="_blank">
                                @System.IO.Path.GetFileName(Model.ImageUpload)
                            </a>
                        </td>
                    </tr>
                </tbody>
            </table>
            <div class="d-flex justify-content-center mt-4">
                <a asp-action="Edit" asp-route-id="@Model?.Id" class="btn btn-primary me-2">Edit</a>
                <a asp-action="Index" class="btn btn-secondary">Back to List</a>
            </div>
        </div>
    </div>
</div>

