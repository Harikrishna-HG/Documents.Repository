@{
    Layout = "_UserLayout";
}
@model Document.Repository.Models.Entities.Student

@{
    ViewData["Title"] = "Create";
}
<style>
    #success-wrapper {
        display: flex;
        justify-content: center;
        align-items: center;
        min-height: 100vh; /* Full viewport height */
        background-color: rgba(0, 0, 0, 0.2); /* Optional semi-transparent background */
        position: fixed; /* Ensure it stays in the center of the screen */
        top: 0;
        left: 0;
        width: 100%;
        z-index: 1250; /* Higher than most elements */
    }

    .success-container {
        text-align: center;
        padding: 2rem;
        background: white;
        border-radius: 15px;
        box-shadow: 0 0 20px rgba(0, 0, 0, 0.1);
        max-width: 500px;
        width: 90%;
    }

    .success-icon {
        width: 3.75rem;
        height: 3.75rem;
        background-color: #072c82;
        border-radius: 50%;
        display: flex;
        justify-content: center;
        align-items: center;
        margin: 0 auto 2rem;
        box-shadow: 0 4px 8px rgba(7, 44, 130, 0.3);
    }

        .success-icon i {
            color: white;
            font-size: 2.375rem;
        }

    .success-title {
        color: rgb(7, 44, 130);
        font-weight: 600;
        margin-bottom: 1rem;
    }

    .success-message {
        color: #6c757d;
        font-size: 1.1rem;
        margin-bottom: 2rem;
    }

    .btn-return {
        background-color: rgb(7, 44, 130);
        border-color: rgb(7, 44, 130);
        padding: 0.75rem 2rem;
        font-weight: 500;
        border-radius: 8px;
        transition: all 0.3s ease;
    }

        .btn-return:hover {
            background-color: #0d6efd;
            border-color: #0d6efd;
            transform: translateY(-2px);
        }

    #error-wrapper {
        display: flex;
        justify-content: center;
        align-items: center;
        min-height: 100vh;
        background-color: rgba(0, 0, 0, 0.2);
        position: fixed;
        top: 0;
        left: 0;
        width: 100%;
        z-index: 1250;
    }

    .error-container {
        text-align: center;
        padding: 2rem;
        background: white;
        border-radius: 15px;
        box-shadow: 0 0 20px rgba(0, 0, 0, 0.2);
        max-width: 500px;
        width: 90%;
        position: relative;
        z-index: 1251;
    }

    .error-icon {
        width: 3.75rem;
        height: 3.75rem;
        background-color: #dc3545;
        border-radius: 50%;
        display: flex;
        justify-content: center;
        align-items: center;
        margin: 0 auto 2rem;
        box-shadow: 0 4px 8px rgba(220, 53, 69, 0.3);
    }

        .error-icon i {
            color: white;
            font-size: 2.375rem;
        }

    .error-title {
        color: #dc3545;
        font-weight: 600;
        margin-bottom: 1rem;
    }

    .error-message {
        color: #6c757d;
        margin-bottom: 2rem;
    }

    .error-details {
        background-color: #f8d7da;
        color: #721c24;
        padding: 1rem;
        border-radius: 8px;
        margin-bottom: 2rem;
        text-align: left;
    }

        .error-details ul {
            margin: 0;
            padding-left: 1.5rem;
        }

        .error-details li {
            margin-bottom: 0.5rem;
        }

    .btn-danger {
        background-color: #dc3545;
        border-color: #dc3545;
        padding: 0.75rem 2rem;
        font-weight: 500;
        border-radius: 8px;
        transition: all 0.3s ease;
        margin-right: 1rem;
    }

        .btn-danger:hover {
            background-color: #bb2d3b;
            border-color: #bb2d3b;
            transform: translateY(-2px);
        }

    .btn-outline-secondary {
        padding: 0.75rem 2rem;
        font-weight: 500;
        border-radius: 8px;
        transition: all 0.3s ease;
    }

        .btn-outline-secondary:hover {
            transform: translateY(-2px);
        }

        </style>


@if (TempData["SuccessMessage"] != null)
{
    <div id="success-wrapper">
        <div class="success-container">
            <div class="success-icon">
                <i class="fas fa-check"></i>
            </div>
            <h4 class="success-title">@TempData["SuccessMessage"]</h4>
            <p class="success-message">Student has been successfully added to the Farwestern University Digital Repository.</p>
            <a asp-action="Create" asp-controller="Students" class="btn btn-primary btn-return">Return to Home</a>
        </div>
    </div>
}

@if (TempData["ErrorMessage"] != null)
{
    <div id="error-wrapper">
        <div class="error-container">
            <div class="error-icon">
                <i class="fas fa-exclamation"></i>
            </div>
            <h2 class="error-title">Submission Failed</h2>
            <p class="error-message">There were some issues with your student submission. Please review the errors below and try again.</p>

            <div class="error-details">
                <ul>
                    <li>@TempData["ErrorMessage"]</li>
                </ul>
            </div>

            <div class="d-flex justify-content-center">
                <a asp-action="Create" asp-controller="Students" class="btn btn-danger">Try Again</a>
            </div>
        </div>
    </div>
}
<h3 class="text-center">New User !! Register Here</h3>
<hr />
<div class="container mt-4 mb-4">
    <div class="row justify-content-center">
        <div class="col-md-10 col-lg-12">
            <div class="p-4 rounded">

                <form asp-action="Create" enctype="multipart/form-data">
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                    <div class="row g-3">
                        <!-- Name -->
                        <div class="col-md-6">
                            <div class="mb-3">
                                <label asp-for="Name" class="form-label fw-bolder">Name <span style="color: red">*</span></label>
                                <input asp-for="Name" class="form-control" placeholder="Enter Your Name..." />
                                <span asp-validation-for="Name" class="text-danger"></span>
                            </div>
                        </div>

                        <!-- Registration number -->
                        <div class="col-md-6">
                            <div class="mb-3">
                                <label asp-for="RegistrationNumber" class="form-label fw-bolder">Registration Number <span style="color: red">*</span></label>
                                <input asp-for="RegistrationNumber" class="form-control" placeholder="Enter Your Registration Number..." />
                                <span asp-validation-for="RegistrationNumber" class="text-danger"></span>
                            </div>
                        </div>

                        <!-- Profile Picture Upload -->
                        <div class="col-md-6">
                            <div class="mb-3">
                                <label asp-for="ProfilePicFile" class="form-label fw-bolder">Profile Picture <span style="color: red">*</span></label>
                                <input asp-for="ProfilePicFile" type="file" class="form-control" />
                                <span asp-validation-for="ProfilePicFile" class="text-danger"></span>
                            </div>
                        </div>

                        <!-- Semester Selection -->
                        <div class="col-md-6">
                            <div class="mb-3">
                                <label asp-for="Semester" class="form-label fw-bolder">Semester <span style="color: red">*</span></label>
                                <select asp-for="Semester" class="form-control">
                                    <option value="">-- Select Semester --</option>
                                    <option value="First">First</option>
                                    <option value="Second">Second</option>
                                    <option value="Third">Third</option>
                                    <option value="Fourth">Fourth</option>
                                    <option value="Fifth">Fifth</option>
                                    <option value="Sixth">Sixth</option>
                                    <option value="Seventh">Seventh</option>
                                    <option value="Eighth">Eighth</option>
                                </select>
                                <span asp-validation-for="Semester" class="text-danger"></span>
                            </div>
                        </div>

                        <!-- College Selection -->
                        <div class="col-md-6">
                            <div class="mb-3">
                                <label class="form-label fw-bolder">College <span style="color: red">*</span></label>
                                <select id="CollegeId" name="CollegeId" class="form-control">
                                    <option disabled selected>-- Select College --</option>
                                    @foreach (var college in ViewBag.CollegeId as SelectList)
                                    {
                                        <option value="@college.Value">@college.Text</option>
                                    }
                                </select>
                            </div>
                        </div>

                        <!-- Department Selection -->
                        <div class="col-md-6">
                            <div class="mb-3">
                                <label class="form-label fw-bolder">Department <span style="color: red">*</span></label>
                                <select id="DepartmentId" class="form-control">
                                    <option disabled selected>-- Select Department --</option>
                                </select>

                            </div>
                        </div>

                        <!-- Program Selection -->
                        <div class="col-md-12">
                            <div class="mb-3">
                                <label asp-for="ProgrammeId" class="form-label fw-bolder">Program <span style="color: red">*</span></label>
                                <select asp-for="ProgrammeId" id="ProgrammeId" class="form-control">
                                    <option disabled selected>-- Select Program --</option>
                                </select>
                                <span asp-validation-for="ProgrammeId" class="text-danger"></span>
                            </div>
                        </div>
                    </div>

                    <!-- Submit Button & Back to List Button -->
                    <div class="d-flex justify-content-between mt-4">
                        <button type="submit" class="btn btn-primary " asp-controller="User" asp-action="Index">Back to Dashboard</button>
                        <button type="submit" class="btn btn-primary">Submit</button>
                    </div>
                </form>

            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
    <script>
        $(document).ready(function () {
            $('#CollegeId').change(function () {
                var collegeId = $(this).val();
                var departmentDropdown = $('#DepartmentId');
                departmentDropdown.empty();
                departmentDropdown.append('<option selected disabled>-- Select Department --</option>');

                if (collegeId) {
                    $.ajax({
                        url: '@Url.Action("GetDepartmentsByCollege", "Students")',
                        type: 'GET',
                        data: { collegeId: collegeId },
                        success: function (data) {
                            $.each(data, function (index, department) {
                                departmentDropdown.append(
                                    $('<option></option>').val(department.id).html(department.name)
                                );
                            });
                        },
                        error: function () {
                            alert('Error loading departments');
                        }
                    });
                }
            });

            $('#DepartmentId').change(function () {
                var departmentId = $(this).val();
                var programmeDropdown = $('#ProgrammeId');
                programmeDropdown.empty();
                programmeDropdown.append('<option selected disabled>-- Select Program --</option>');

                if (departmentId) {
                    $.ajax({
                        url: '@Url.Action("GetProgrammeByDepartment", "Students")',
                        type: 'GET',
                        data: { departmentId: departmentId },
                        success: function (data) {
                            $.each(data, function (index, programme) {
                                programmeDropdown.append(
                                    $('<option></option>').val(programme.id).html(programme.name)
                                );
                            });
                        },
                        error: function () {
                            alert('Error loading programs');
                        }
                    });
                }
            });
        });
    </script>
}

