@{
    Layout = "_UserLayout";
}
@model Document.Repository.Models.CreateStudentAccountViewModel

@{
    ViewData["Title"] = "Add Student";
}

<h3 class="text-center">Add Student Account</h3>
<p class="text-center text-muted">Creates the student login and their profile in one step. The student can sign in immediately.</p>
<hr />

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success text-center">@TempData["SuccessMessage"]</div>
}

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger text-center">@TempData["ErrorMessage"]</div>
}

<div class="container mt-4 mb-4">
    <div class="row justify-content-center">
        <div class="col-md-10 col-lg-12">
            <div class="p-4 rounded">

                <form asp-action="CreateForUser" asp-controller="Students" enctype="multipart/form-data">
                    <div asp-validation-summary="All" class="text-danger mb-3"></div>

                    <h5 class="fw-bolder mb-3">Login details</h5>
                    <div class="row g-3 mb-4">
                        <div class="col-md-6">
                            <div class="mb-3">
                                <label asp-for="Email" class="form-label fw-bolder"></label>
                                <input asp-for="Email" class="form-control" placeholder="student@fwu.edu.np" />
                                <span asp-validation-for="Email" class="text-danger"></span>
                            </div>
                        </div>

                        <div class="col-md-3">
                            <div class="mb-3">
                                <label asp-for="Password" class="form-label fw-bolder"></label>
                                <input asp-for="Password" class="form-control" />
                                <span asp-validation-for="Password" class="text-danger"></span>
                            </div>
                        </div>

                        <div class="col-md-3">
                            <div class="mb-3">
                                <label asp-for="ConfirmPassword" class="form-label fw-bolder"></label>
                                <input asp-for="ConfirmPassword" class="form-control" />
                                <span asp-validation-for="ConfirmPassword" class="text-danger"></span>
                            </div>
                        </div>
                    </div>

                    <h5 class="fw-bolder mb-3">Student details</h5>
                    <div class="row g-3">
                        <div class="col-md-6">
                            <div class="mb-3">
                                <label asp-for="Name" class="form-label fw-bolder"></label>
                                <input asp-for="Name" class="form-control" placeholder="Enter the student's name..." />
                                <span asp-validation-for="Name" class="text-danger"></span>
                            </div>
                        </div>

                        <div class="col-md-6">
                            <div class="mb-3">
                                <label asp-for="RegistrationNumber" class="form-label fw-bolder"></label>
                                <input asp-for="RegistrationNumber" class="form-control" placeholder="Enter the registration number..." />
                                <span asp-validation-for="RegistrationNumber" class="text-danger"></span>
                            </div>
                        </div>

                        <div class="col-md-6">
                            <div class="mb-3">
                                <label asp-for="ProfilePicFile" class="form-label fw-bolder"></label>
                                <input asp-for="ProfilePicFile" type="file" class="form-control" accept=".jpg,.jpeg,.png" />
                                <span asp-validation-for="ProfilePicFile" class="text-danger"></span>
                            </div>
                        </div>

                        <div class="col-md-6">
                            <div class="mb-3">
                                <label asp-for="Semester" class="form-label fw-bolder"></label>
                                <select asp-for="Semester" class="form-control">
                                    <option value="">-- Select Semester --</option>
                                    <option value="First">First</option>
                                    <option value="Second">Second</option>
                                    <option value="Third">Third</option>
                                    <option value="Fourth">Fourth</option>
                                    <option value="Fifth">Fifth</option>
                                    <option value="Sixth">Sixth</option>
                                    <option value="Seventh">Seventh</option>
                                    <option value="Eighth">Eighth</option>
                                </select>
                                <span asp-validation-for="Semester" class="text-danger"></span>
                            </div>
                        </div>

                        <div class="col-md-6">
                            <div class="mb-3">
                                <label class="form-label fw-bolder">College <span style="color: red">*</span></label>
                                <select id="CollegeId" name="CollegeId" class="form-control">
                                    <option disabled selected>-- Select College --</option>
                                    @foreach (var college in ViewBag.CollegeId as SelectList)
                                    {
                                        <option value="@college.Value">@college.Text</option>
                                    }
                                </select>
                            </div>
                        </div>

                        <div class="col-md-6">
                            <div class="mb-3">
                                <label class="form-label fw-bolder">Department <span style="color: red">*</span></label>
                                <select id="DepartmentId" class="form-control">
                                    <option disabled selected>-- Select Department --</option>
                                </select>
                            </div>
                        </div>

                        <div class="col-md-12">
                            <div class="mb-3">
                                <label asp-for="ProgrammeId" class="form-label fw-bolder"></label>
                                <select asp-for="ProgrammeId" id="ProgrammeId" class="form-control">
                                    <option disabled selected>-- Select Program --</option>
                                </select>
                                <span asp-validation-for="ProgrammeId" class="text-danger"></span>
                            </div>
                        </div>
                    </div>

                    <div class="d-flex justify-content-between mt-4">
                        <a asp-action="Index" asp-controller="Students" class="btn btn-outline-secondary">Back to Student List</a>
                        <button type="submit" class="btn btn-primary">Create Student</button>
                    </div>
                </form>

            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
    <script>
        $(document).ready(function () {
            $('#CollegeId').change(function () {
                var collegeId = $(this).val();
                var departmentDropdown = $('#DepartmentId');
                departmentDropdown.empty();
                departmentDropdown.append('<option selected disabled>-- Select Department --</option>');

                if (collegeId) {
                    $.ajax({
                        url: '@Url.Action("GetDepartmentsByCollege", "Students")',
                        type: 'GET',
                        data: { collegeId: collegeId },
                        success: function (data) {
                            $.each(data, function (index, department) {
                                departmentDropdown.append(
                                    $('<option></option>').val(department.id).html(department.name)
                                );
                            });
                        },
                        error: function () {
                            alert('Error loading departments');
                        }
                    });
                }
            });

            $('#DepartmentId').change(function () {
                var departmentId = $(this).val();
                var programmeDropdown = $('#ProgrammeId');
                programmeDropdown.empty();
                programmeDropdown.append('<option selected disabled>-- Select Program --</option>');

                if (departmentId) {
                    $.ajax({
                        url: '@Url.Action("GetProgrammeByDepartment", "Students")',
                        type: 'GET',
                        data: { departmentId: departmentId },
                        success: function (data) {
                            $.each(data, function (index, programme) {
                                programmeDropdown.append(
                                    $('<option></option>').val(programme.id).html(programme.name)
                                );
                            });
                        },
                        error: function () {
                            alert('Error loading programs');
                        }
                    });
                }
            });
        });
    </script>
}
