@{
    Layout = "_UserLayout";
}
@model Document.Repository.Models.Entities.Student

@{
    ViewData["Title"] = "Details";
}

<h1 class="text-center pt-4">Details</h1>

<div class="mx-auto p-4 " style="max-width: 700px; background-color: #f8f9fa; border-radius: 10px;">
    <h4 class="text-center">Student</h4>
    <hr />
    <dl class="row">
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.Name)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Name)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.RegistrationNumber)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.RegistrationNumber)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.ProfilePic)
        </dt>
        <dd class = "col-sm-10">
            @if (!string.IsNullOrEmpty(Model.ProfilePic))
            {
                <img src="/@Model.ProfilePic" alt="Profile Picture"
                     style="width: 150px; height: 150px; object-fit: cover; border-radius: 50%;" />
            }
            else
            {
                <span>No Image Available</span>
            }
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.Semester)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Semester)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.Programme)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Programme.Name)
        </dd>
        <dt class="col-sm-2">
            College
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Programme.Department.College.Name)
        </dd>
        <dt class="col-sm-2">
            Department
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Programme.Department.Name)
        </dd>
    </dl>
    <div class="d-flex mt-4">
        <a asp-action="Edit" asp-route-id="@Model?.Id" class="btn btn-warning flex-fill me-2" style="width: 50%;">Edit</a>
        <a asp-action="Index" class="btn btn-primary flex-fill ms-2" style="width: 50%;">Back to List</a>
    </div>
</div>

