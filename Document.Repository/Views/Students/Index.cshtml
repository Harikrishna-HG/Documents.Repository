@{
    Layout = "_UserLayout";
}
@model IEnumerable<Document.Repository.Models.Entities.Student>

@{
    ViewData["Title"] = "Index";
    var currentSearch = Context.Request.Query["searchString"];
}
<div class="d-flex flex-column flex-md-row justify-content-between align-items-center pt-4 pb-2 gap-2">
    <h3 class="text-center">List of Students</h3>

    <div class="d-flex flex-wrap gap-2">
    <form class="d-flex" asp-action="Index" asp-controller="Students" method="get">
        <input type="search" name="searchString" class="form-control me-2" placeholder="Search by Name, Email, or Roll No" value="@currentSearch" style="min-width: 250px;" />
        <button type="submit" class="btn btn-outline-primary">Search</button>
    </form>
    @if (!string.IsNullOrEmpty(currentSearch))
    {
            <a asp-action="Index" class="btn btn-outline-secondary">Back to full list</a>
    }
    <a asp-action="Create" class="btn btn-primary">Add New</a>
</div>
</div>
<hr />


<div class="table-responsive mx-1 mx-md-2">
    <table class="table table-striped">
        <thead class="text-center">
            <tr>
                <th>
                    @Html.DisplayNameFor(model => model.ProfilePic)
                </th>

                <th>
                    <a asp-action="Index"
                       asp-route-sortOrder="@ViewData["NameSortParam"]"
                       asp-route-searchString="@currentSearch"
                       class="text-decoration-none text-dark">
                        @Html.DisplayNameFor(model => model.Name)
                        @if (ViewData["NameSortParam"]?.ToString() == "")
                        {
                            <i class="bi bi-arrow-down"></i>
                        }
                        else if (ViewData["NameSortParam"]?.ToString() == "name_desc")
                        {
                            <i class="bi bi-arrow-up"></i>
                        }
                        else
                        {
                            <i class="bi bi-arrow-down-up"></i>
                        }
                    </a>
                </th>
                <th>
                    <a asp-action="Index"
                       asp-route-sortOrder="@ViewData["RegSortParam"]"
                       asp-route-searchString="@currentSearch"
                       class="text-decoration-none text-dark">
                        @Html.DisplayNameFor(model => model.RegistrationNumber)
                        @if (ViewData["CurrentSort"]?.ToString() == "reg")
                        {
                            <i class="bi bi-arrow-down"></i>
                        }
                        else if (ViewData["CurrentSort"]?.ToString() == "reg_desc")
                        {
                            <i class="bi bi-arrow-up"></i>
                        }
                        else
                        {
                            <i class="bi bi-arrow-down-up"></i>
                        }
                    </a>
                </th>
                <th>
                    @Html.DisplayNameFor(model => model.Semester)
                </th>
                <th>
                    @Html.DisplayNameFor(model => model.Programme)
                </th>
                <th>
                    Department
                </th>
                <th>
                    College
                </th>

                <th> Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>
                        @if (!string.IsNullOrEmpty(item.ProfilePic))
                        {
                            <img src="@item.ProfilePic" alt=" Profile Picture " class="profile-pic" />
                        }
                        else
                        {
                            <span>No Image</span>
                        }
                    </td>
                    <td>
                        @Html.DisplayFor(modelItem => item.Name)
                    </td>
                    <td>
                        @Html.DisplayFor(modelItem => item.RegistrationNumber)
                    </td>

                    <td>
                        @Html.DisplayFor(modelItem => item.Semester)
                    </td>
                    <td>
                        @Html.DisplayFor(modelItem => item.Programme.Name)
                    </td>

                    <td>
                        @Html.DisplayFor(modelItem => item.Programme.Department.Name)
                    </td>

                    <td>
                        @Html.DisplayFor(modelItem => item.Programme.Department.College.Name)
                    </td>

                    <td>
                        <div class="d-flex justify-content-evenly">
                            <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-primary me-2">
                                <i class="bi bi-pencil"></i>
                            </a>
                            <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-warning me-2">
                                <i class="bi bi-info-circle"></i>
                            </a>
                            <form asp-action="Delete" method="post" class="d-inline">
                                <input type="hidden" name="id" value="@item.Id" />
                                <button type="button"
                                        class="btn btn-sm btn-danger me-2"
                                        onclick="if(confirm('Are you sure you want to delete this student ?')) this.closest('form').submit();">
                                    <i class="bi bi-trash3"></i>
                                </button>
                            </form>
                        </div>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

<style>
    .profile-pic {
        width: 50px;
        height: 50px;
        object-fit: cover;
    }
</style>
