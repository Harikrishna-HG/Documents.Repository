@{
    Layout = "_UserLayout";
}
@model Document.Repository.Models.Entities.Tag

@{
    ViewData["Title"] = "Create";
}

<h3 class="text-center">Create a New Tag</h3>
<hr />
<div class="container mb-4">
    <div class="row justify-content-center">
        <div class="col-md-10 col-lg-12">
            <div class="p-4">
                <form asp-action="Create">
                    <div class="row g-3">

                        <!-- Name -->
                        <div class="col-md-6">
                            <div class="mb-3">
                                <label asp-for="Name" class="form-label fw-bolder">Tag Name  <span style="color: red">*</span></label>
                                <input asp-for="Name" class="form-control" placeholder="Enter tag name..." />
                                <span asp-validation-for="Name" class="text-danger"></span>
                            </div>
                        </div>

                        <!-- Description -->
                        <div class="col-md-6">
                            <div class="mb-3">
                                <label asp-for="Description" class="form-label fw-bolder">Description</label>
                                <input asp-for="Description" class="form-control" placeholder="Enter description..." />
                                <span asp-validation-for="Description" class="text-danger"></span>
                            </div>
                        </div>

                        <!-- Tag Categories -->
                        <div class="col-12">
                            <div class="mb-3">
                                <label asp-for="TagCategoryId" class="form-label fw-bolder">Tag Category <span style="color: red">*</span></label>
                                <select asp-for="TagCategoryId" class="form-control" asp-items="ViewBag.TagCategoryId">
                                    <option value="" disabled selected>Select a category</option>
                                </select>
                                <span asp-validation-for="TagCategoryId" class="text-danger"></span>
                            </div>
                        </div>

                    </div>

                    <!-- Submit Button & Back to List Button -->
                    <div class="d-flex justify-content-between mt-4">
                        <a asp-action="Index" class="btn btn-primary">Back to List</a>
                        <button type="submit" class="btn btn-primary">Create</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {

    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
