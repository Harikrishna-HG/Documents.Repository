@model Document.Repository.ViewModels.ProfileViewModel

@{
    Layout = "_UserLayout";
}
<style>
    .profile-header {
        background: linear-gradient(135deg, #072c82 0%, #0d6efd 100%);
        padding: 2rem 0;
        margin-bottom: 2rem;
        color: white;
    }

    .profile-image-container {
        position: relative;
        width: 150px;
        height: 150px;
        margin: 0 auto;
    }

    .profile-image {
        width: 100%;
        height: 100%;
        border-radius: 50%;
        object-fit: cover;
        border: 5px solid white;
        box-shadow: 0 0 20px rgba(0,0,0,0.2);
    }

    .edit-profile-btn {
        position: absolute;
        bottom: 0;
        right: 0;
        background: white;
        border-radius: 50%;
        width: 40px;
        height: 40px;
        display: flex;
        align-items: center;
        justify-content: center;
        box-shadow: 0 2px 5px rgba(0,0,0,0.2);
        cursor: pointer;
        transition: all 0.3s ease;
    }

        .edit-profile-btn:hover {
            transform: scale(1.1);
            background: #f8f9fa;
        }

    .profile-stats {
        background: white;
        border-radius: 10px;
        padding: 1.5rem;
        box-shadow: 0 0 15px rgba(0,0,0,0.1);
        margin-bottom: 2rem;
    }

    .stat-item {
        text-align: center;
        padding: 1rem;
    }

    .stat-number {
        font-size: 2rem;
        font-weight: bold;
        color: #072c82;
    }

    .stat-label {
        color: #6c757d;
        font-size: 0.9rem;
    }

    .project-card {
        transition: transform 0.3s ease;
    }

        .project-card:hover {
            transform: translateY(-5px);
        }

    .project-image {
        height: 200px;
        object-fit: cover;
    }

    .container-no-gutter {
        padding-left: 0;
        padding-right: 0;
    }

    @@media (max-width: 768px) {
        .main-content {
            margin-left: 0;
            width: 100%;
        }

        .profile-header .col-md-8 {
            text-align: center;
        }
    }
</style>

<!-- Main Content -->
<div class="profile-header">
    <div class="container-no-gutter">
        <div class="row align-items-center">
            <div class="col-md-4 text-center">
                <div class="profile-image-container">
                    <img src="../@Model.ProfilePic" alt="Profile" class="profile-image">
                    <div class="edit-profile-btn">
                        <i class="fas fa-camera"></i>
                    </div>
                </div>
            </div>
            <div class="col-md-8 text-md-start text-center">
                <h2 class="mb-2">@Model.Name</h2>
                <p class="mb-1"><i class="fas fa-graduation-cap me-2"></i>@Model.Semester</p>
                <p class="mb-1"><i class="fas fa-university me-2"></i>@Model.College</p>
                <p class="mb-0"><i class="fas fa-envelope me-2"></i>@Model.Email</p>
            </div>
        </div>
    </div>
</div>

<div class="container-no-gutter">
    <!-- Profile Stats -->
    <div class="profile-stats">
        <div class="row">
            <div class="col-md-4">
                <div class="stat-item">
                    <div class="stat-number">@Model.Projects.Count</div>
                    <div class="stat-label">Projects Uploaded</div>
                </div>
            </div>
            <div class="col-md-4">
                <div class="stat-item">
                    <div class="stat-number">@Model.Projects.Count(p => p.Status == Document.Repository.Models.Entities.ProjectStatus.Approved)</div>
                    <div class="stat-label">Projects Approved</div>
                </div>
            </div>
            <div class="col-md-4">
                <div class="stat-item">
                    <div class="stat-number">@Model.Projects.Count(p => p.Status == Document.Repository.Models.Entities.ProjectStatus.Rejected)</div>
                    <div class="stat-label">Projects Rejected</div>
                </div>
            </div>
        </div>
    </div>

    <!-- Projects Section -->
    <div class="row mb-4">
        <div class="col-12">
            <h4 class="mb-4">My Projects</h4>
        </div>
        @foreach (var project in Model.Projects)
        {
            <div class="col-md-6 col-lg-4 mb-4">
                <div class="card project-card h-100">
                    <img src="../@project.Thumbnail" class="card-img-top project-image" alt="Project @project.Title">
                    <div class="card-body">
                        <h5 class="card-title">@project.Title</h5>
                        <p class="card-text">
                            @(project.Abstract.Length > 180 ? project.Abstract.Substring(0, 80) + "..." : project.Abstract)
                        </p>
                        <div class="d-flex justify-content-between align-items-center">
                            <span class="badge p-2 @(project.Status == Document.Repository.Models.Entities.ProjectStatus.Submitted ? "bg-primary" :
                         project.Status == Document.Repository.Models.Entities.ProjectStatus.Approved ? "bg-success" :
                         project.Status == Document.Repository.Models.Entities.ProjectStatus.Rejected ? "bg-danger" : "bg-warning")">
                                @project.Status
                            </span>

                            <div class="btn-group">
                                @if (project.Status != Document.Repository.Models.Entities.ProjectStatus.Approved)
                                {
                                    <a class="btn btn-sm btn-outline-primary" asp-controller="Projects" asp-action="Edit" asp-route-id="@project.Id">
                                        <i class="fas fa-edit"></i> Edit
                                    </a>
                                    <form asp-controller="Projects" asp-action="Delete" asp-route-id="@project.Id" method="post" onsubmit="return confirm('Are you sure you want to delete this project?');">
                                        <button type="submit" class="btn btn-sm btn-outline-danger">
                                            <i class="fas fa-trash"></i> Delete
                                        </button>
                                    </form>
                                }
                                else
                                {
                                    <button class="btn btn-sm btn-outline-secondary" disabled>
                                        <i class="fas fa-edit"></i> Edit
                                    </button>
                                    <button class="btn btn-sm btn-outline-secondary" disabled>
                                        <i class="fas fa-trash"></i> Delete
                                    </button>
                                }
                            </div>
                        </div>
                    </div>
                </div>
            </div>

        }
    </div>
