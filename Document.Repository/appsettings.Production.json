{
  "ConnectionStrings": {
    "DefaultConnection": "Server=#{SQL_SERVER}#;Database=#{SQL_DATABASE}#;User Id=#{SQL_USER}#;Password=#{SQL_PASSWORD}#;Encrypt=True;TrustServerCertificate=False;MultipleActiveResultSets=true"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Warning",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Error"
    }
  },
  "AllowedHosts": "*",
  "ApplicationInsights": {
    "InstrumentationKey": "#{APPINSIGHTS_KEY}#"
  }
}
